{
  "id": "qrcode-barcode-scanner",
  "name": "QR Code & Barcode Scanner",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "scanner",
      "label": {
        "default": "QR Code & Barcode Scanner"
      },
      "minimumSize": { "width": 240, "height": 320 },
      "maximumSize": { "width": 2000, "height": 4000 },
      "preferredDockedSize": { "width": 280, "height": 600 },
      "preferredFloatingSize": { "width": 300, "height": 640 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["darkest", "dark"] },
        { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["darkest", "dark"], "species": ["generic"] },
    { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["generic"] }
  ]
}
