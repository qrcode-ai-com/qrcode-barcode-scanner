{
  "name": "@qrcode-ai-com/jupyterlab-qrcode-barcode-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Read QR codes and barcodes in JupyterLab: a panel that scans an image in the browser with the open-source QR Code & Barcode Scanner engine.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "qr-code",
    "barcode",
    "scanner",
    "webassembly"
  ],
  "homepage": "https://qrcode-ai.com/en-US/qr-code-scanner/integrations/jupyterlab",
  "bugs": {
    "url": "https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust/issues"
  },
  "license": "MIT AND AGPL-3.0-or-later",
  "author": "Thibaut Mélen & Nicolas Cella",
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}",
    "style/**/*.{css,js}",
    "src/**/*.ts"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qrcode-ai-com/qrcode-barcode-scanner-rust.git",
    "directory": "integrations/jupyterlab"
  },
  "scripts": {
    "build": "npm run build:lib && jupyter-builder build --development True .",
    "build:prod": "npm run clean && npm run build:lib && jupyter-builder build . && node scripts/notices.mjs",
    "build:lib": "tsc",
    "clean": "node scripts/clean.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/filebrowser": "^4.0.0",
    "@jupyterlab/launcher": "^4.0.0",
    "@jupyterlab/ui-components": "^4.0.0",
    "@lumino/widgets": "^2.0.0",
    "@qrcode-ai-com/qrcode-barcode-scanner-wasm": "0.11.0"
  },
  "devDependencies": {
    "@jupyter/builder": "1.3.0",
    "@types/node": "22.19.1",
    "typescript": "5.5.4"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_qrcode_barcode_scanner/labextension"
  }
}
