<Project Sdk="Microsoft.NET.Sdk">

  <!-- A spike, not a package: it proves that C# generated by uniffi-bindgen-cs loads the engine's
       UniFFI library and scans in process. The generated file and the native library are produced
       by the workflow from one commit and are never checked in. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>QrscanSpike</AssemblyName>
    <RootNamespace>QrscanSpike</RootNamespace>
  </PropertyGroup>

  <!-- The native library sits beside the program: that is where .NET looks for it first. -->
  <ItemGroup>
    <None Include="native/*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
