<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET package of the QR Code & Barcode Scanner engine. Its inputs are written by the
       workflow from one commit and are never checked in: generated/, the C# that
       uniffi-bindgen-cs writes from the engine's UniFFI library, and that library, as native/
       for the tests or runtimes/ for the package. The version is the engine's: pass it with
       -p:Version. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated code reads and writes native memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>QRCodeAI.QRCodeBarcodeScanner</AssemblyName>
    <RootNamespace>QRCodeAI.QRCodeBarcodeScanner</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <!-- What nuget.org shows. scripts/dotnet-package.py inspect holds the same values. -->
  <PropertyGroup>
    <PackageId>QRCodeAI.QRCodeBarcodeScanner</PackageId>
    <Title>QR Code &amp; Barcode Scanner</Title>
    <Authors>QR Code AI</Authors>
    <Description>Read QR codes and barcodes from an image in .NET, in process: QR Code, Data Matrix, Aztec, PDF417, Code 128, EAN and more. The engine is inside the package, and its JSON report is returned unchanged.</Description>
    <PackageTags>qr-code;qrcode;barcode;scanner;reader;data-matrix;code128;ean</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://qrcode-ai.com/en-US/qr-code-scanner/sdk/dotnet</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/qrcode-ai-com/qrcode-barcode-scanner</RepositoryUrl>
    <!-- The commit comes from the caller, with -p:RepositoryCommit: never from the build host. -->
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- For the tests of this folder: the library of the host sits beside the assembly, where
       .NET looks for it first. It is never packed. -->
  <ItemGroup>
    <None Include="native/*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Pack="false" />
  </ItemGroup>

  <!-- For the package: the five libraries, laid out by scripts/dotnet-package.py layout. A
       .NET application loads the one of its system from runtimes/<rid>/native/. -->
  <ItemGroup>
    <None Remove="runtimes/**/*" />
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QRCodeAI.QRCodeBarcodeScanner.Tests" />
  </ItemGroup>

</Project>
