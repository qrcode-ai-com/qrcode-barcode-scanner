# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# pubspec.lock is tracked. The release jobs resolve exactly it (`flutter pub get
# --enforce-lockfile`, with the Flutter SDK pinned in .github/workflows/flutter.yml).
# pub does not publish it, so a consuming app still resolves its own versions.
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Rust build artifacts (cargokit builds these at app-build time)
rust/target/
